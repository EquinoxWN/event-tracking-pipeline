{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EquinoxWN/event-tracking-pipeline/schemas/event.v1.json",
  "title": "Tracked event, version 1",
  "description": "One event sent by the JavaScript tracker. Unknown top-level fields are rejected; new fields are added as optional.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "type", "name", "anonymous_id", "timestamp"],
  "properties": {
    "schema_version": { "const": 1 },
    "event_id": {
      "description": "Random UUID made by the tracker; the collector stores each id once, so a retried batch is not counted twice.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "type": { "enum": ["track", "page", "identify"] },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_ .:-]{0,127}$"
    },
    "anonymous_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,64}$"
    },
    "user_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 128
    },
    "timestamp": {
      "description": "Client time in UTC (RFC 3339 with Z). Stored as given, next to the collector's own received_at.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page_url": { "type": "string", "maxLength": 2048 },
        "referrer": { "type": "string", "maxLength": 2048 },
        "locale": { "type": "string", "maxLength": 35 },
        "user_agent": { "type": "string", "maxLength": 512 },
        "library": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "maxLength": 64 },
            "version": { "type": "string", "maxLength": 32 }
          }
        }
      }
    },
    "properties": {
      "description": "Free-form event properties: flat, at most 50 keys, scalar values only.",
      "type": "object",
      "maxProperties": 50,
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" },
      "additionalProperties": {
        "anyOf": [
          { "type": "string", "maxLength": 1024 },
          { "type": "number" },
          { "type": "boolean" },
          { "type": "null" }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": { "required": ["type"], "properties": { "type": { "const": "identify" } } },
      "then": { "required": ["user_id"], "properties": { "user_id": { "type": "string" } } }
    }
  ]
}
